{
  "name": "samotest",
  "version": "0.1.3",
  "description": "Manual test scenario runner and evidence gate CLI.",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "samotest": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "docs/",
    "samples/",
    "LICENSE",
    "README.md",
    "SPEC.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "start": "tsx src/cli.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tanya301/samotest.git"
  },
  "bugs": {
    "url": "https://github.com/Tanya301/samotest/issues"
  },
  "homepage": "https://github.com/Tanya301/samotest#readme",
  "license": "Apache-2.0",
  "dependencies": {
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
