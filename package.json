{
  "name": "samotest",
  "version": "0.2.0",
  "description": "Manual test scenario runner and evidence gate CLI.",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "main": "./dist/cli.js",
  "bin": {
    "samotest": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "docs/",
    "samples/",
    "LICENSE",
    "README.md",
    "SPEC.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "prepack": "bun run build",
    "start": "bun src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tanya301/samotest.git"
  },
  "bugs": {
    "url": "https://github.com/Tanya301/samotest/issues"
  },
  "homepage": "https://github.com/Tanya301/samotest#readme",
  "license": "Apache-2.0",
  "dependencies": {
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "bun": ">=1.3.13",
    "node": ">=20"
  }
}
